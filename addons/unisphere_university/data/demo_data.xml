<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Academic Departments -->
    <record id="dept_cs" model="unisphere.department">
        <field name="name">Department of Computer Science</field>
        <field name="code">CS</field>
        <field name="description">Pioneering computing education, software development, theoretical algorithms, and distributed computing.</field>
    </record>

    <record id="dept_se" model="unisphere.department">
        <field name="name">Department of Software Engineering</field>
        <field name="code">SE</field>
        <field name="description">Focusing on enterprise software architecture, full-stack methodologies, cloud DevOps, and engineering quality assurance.</field>
    </record>

    <record id="dept_ee" model="unisphere.department">
        <field name="name">Department of Electrical Engineering</field>
        <field name="code">EE</field>
        <field name="description">Specializing in digital systems, linear signal processing, power electronics, and embedded microcontrollers.</field>
    </record>

    <record id="dept_ai" model="unisphere.department">
        <field name="name">Department of Artificial Intelligence</field>
        <field name="code">AI</field>
        <field name="description">Dedicated to machine learning, neural networks, natural language processing, and autonomous robotic agents.</field>
    </record>

    <record id="dept_ms" model="unisphere.department">
        <field name="name">Department of Management Sciences</field>
        <field name="code">MS</field>
        <field name="description">Equipping future technology leaders with organizational management, tech entrepreneurship, and economics.</field>
    </record>

    <!-- 2. Academic Semesters / Terms -->
