    <!-- 3. Course Catalog -->
    <record id="course_cs101" model="unisphere.course">
        <field name="name">Introduction to Computing</field>
        <field name="code">CS101</field>
        <field name="department_id" ref="dept_cs"/>
        <field name="credit_hours">3</field>
        <field name="description">Foundations of computer systems, algorithmic problem solving, binary architecture, and introductory Python programming.</field>
    </record>

    <record id="course_cs201" model="unisphere.course">
        <field name="name">Data Structures &amp; Algorithms</field>
        <field name="code">CS201</field>
        <field name="department_id" ref="dept_cs"/>
        <field name="credit_hours">4</field>
        <field name="description">Abstract data types, dynamic arrays, linked lists, trees, graphs, sorting algorithms, and asymptotic complexity analysis.</field>
    </record>

    <record id="course_se301" model="unisphere.course">
        <field name="name">Software Architecture &amp; Design</field>
        <field name="code">SE301</field>
        <field name="department_id" ref="dept_se"/>
        <field name="credit_hours">3</field>
        <field name="description">Architectural patterns, microservices vs monoliths, design principles (SOLID), UML modeling, and component coupling.</field>
    </record>

    <record id="course_ee101" model="unisphere.course">
        <field name="name">Linear Circuit Analysis</field>
        <field name="code">EE101</field>
        <field name="department_id" ref="dept_ee"/>
        <field name="credit_hours">4</field>
        <field name="description">DC and AC circuit laws, Kirchhoff's laws, nodal and mesh analysis, Thevenin equivalent theorems, and operational amplifiers.</field>
    </record>

    <record id="course_ai201" model="unisphere.course">
        <field name="name">Artificial Intelligence &amp; Machine Learning</field>
        <field name="code">AI201</field>
        <field name="department_id" ref="dept_ai"/>
        <field name="credit_hours">3</field>
        <field name="description">Heuristic search strategies, probabilistic reasoning, supervised learning algorithms, gradient descent, and deep neural networks.</field>
    </record>

    <record id="course_ms101" model="unisphere.course">
        <field name="name">Principles of Management</field>
        <field name="code">MS101</field>
        <field name="department_id" ref="dept_ms"/>
        <field name="credit_hours">3</field>
        <field name="description">Foundational management concepts, strategic planning, team leadership, organizational dynamics, and business decision making.</field>
    </record>

