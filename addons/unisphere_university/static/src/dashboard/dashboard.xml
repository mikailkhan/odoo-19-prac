<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="unisphere_university.Dashboard">
        <div class="o_unisphere_dashboard">
            <!-- Loading Spinner State -->
            <div t-if="state.loading" class="d-flex justify-content-center align-items-center p-5 min-vh-50">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading Dashboard...</span>
                </div>
            </div>

            <!-- Dashboard Content -->
            <div t-elif="state.data" class="uni-dashboard-container">
                <!-- 1. Top Executive Header Strip -->
                <header class="uni-dashboard-header">
                    <div class="uni-header-title-group">
                        <div class="uni-badge-system">
                            <i class="fa fa-university me-1"/>
                            <span>Northstar Institutional ERP • v19.0</span>
                        </div>
                        <h1>Executive Academic Dashboard</h1>
                        <p>
                            Northstar University of Technology • Main Campus, Islamabad • Sector H-12 Academic Enclave
                        </p>
                    </div>

                    <div class="uni-header-toolbar">
                        <!-- Term Switcher Dropdown -->
                        <div class="uni-term-select-wrapper">
                            <i class="fa fa-graduation-cap term-icon"/>
                            <select class="uni-term-select" t-on-change="onTermChange">
                                <t t-foreach="state.data.terms" t-as="term" t-key="term.id">
                                    <option t-att-value="term.id" t-att-selected="term.id === state.selectedTermId">
                                        <t t-esc="term.name"/> <t t-if="term.is_active">(Active)</t>
                                    </option>
                                </t>
                            </select>
                        </div>

                        <span class="uni-toolbar-divider"/>

                        <!-- Quick Action Buttons -->
                        <div class="uni-action-btn-group">
                            <button class="btn-uni-outline" t-on-click="openCreateStudent" title="Register New Student">
                                <i class="fa fa-user-plus text-primary"/>
                                <span>Add Student</span>
                            </button>
                            <button class="btn-uni-outline" t-on-click="openCreateSection" title="Create Course Section">
                                <i class="fa fa-book text-info"/>
                                <span>New Section</span>
                            </button>
                            <button class="btn-uni-outline" t-on-click="openTakeAttendance" title="Mark Session Attendance">
                                <i class="fa fa-calendar-check-o text-success"/>
                                <span>Attendance</span>
                            </button>
                            <button class="btn-uni-primary" t-on-click="openCreateFee" title="Issue Bursar Challan">
                                <i class="fa fa-credit-card"/>
                                <span>Issue Challan</span>
                            </button>
                        </div>
                    </div>
                </header>

                <!-- 2. 4 Hero KPI Cards Grid -->
                <div class="uni-kpi-grid">
                    <!-- KPI 1: Active Enrollment -->
                    <div class="uni-kpi-card" t-on-click="openStudentsList">
                        <div class="uni-kpi-top">
                            <div class="uni-kpi-info">
                                <span class="uni-kpi-label">Active Enrollment</span>
                                <div class="uni-kpi-value-row">
                                    <span class="uni-kpi-value"><t t-esc="state.data.kpis.active_enrollments"/></span>
                                    <span class="uni-kpi-pill green">
                                        <i class="fa fa-arrow-up me-1"/> Cohort '24
                                    </span>
                                </div>
                            </div>
                            <div class="uni-kpi-icon blue">
                                <i class="fa fa-graduation-cap"/>
                            </div>
                        </div>
                        <div class="uni-kpi-footer">
                            <span><t t-esc="state.data.kpis.total_students"/> Registered • <strong><t t-esc="state.data.kpis.active_enrollments"/> Active Seats</strong></span>
                            <i class="fa fa-chevron-right"/>
                        </div>
                    </div>

                    <!-- KPI 2: Faculty & Offerings -->
                    <div class="uni-kpi-card" t-on-click="openFacultyList">
                        <div class="uni-kpi-top">
                            <div class="uni-kpi-info">
                                <span class="uni-kpi-label">Faculty &amp; Teaching Staff</span>
                                <div class="uni-kpi-value-row">
                                    <span class="uni-kpi-value"><t t-esc="state.data.kpis.faculty_count"/></span>
                                    <span class="uni-kpi-pill teal">
                                        100% Active
                                    </span>
                                </div>
                            </div>
                            <div class="uni-kpi-icon teal">
                                <i class="fa fa-users"/>
                            </div>
                        </div>
                        <div class="uni-kpi-footer">
                            <span>Active Sections: <strong><t t-esc="state.data.kpis.active_sections"/> Offerings</strong></span>
                            <i class="fa fa-chevron-right"/>
                        </div>
                    </div>

                    <!-- KPI 3: Academic Health (CGPA & Attendance) -->
                    <div class="uni-kpi-card" t-on-click="openSectionsList">
                        <div class="uni-kpi-top">
                            <div class="uni-kpi-info">
                                <span class="uni-kpi-label">Average Attendance</span>
                                <div class="uni-kpi-value-row">
                                    <span class="uni-kpi-value"><t t-esc="state.data.kpis.avg_attendance"/>%</span>
                                    <span class="uni-kpi-pill green" t-if="state.data.kpis.avg_attendance >= 75">
                                        Standard Met
                                    </span>
                                    <span class="uni-kpi-pill amber" t-else="">
                                        Action Needed
                                    </span>
                                </div>
                            </div>
                            <div class="uni-kpi-icon purple">
                                <i class="fa fa-line-chart"/>
                            </div>
                        </div>
                        <div class="uni-kpi-footer">
                            <span>Term Avg CGPA: <strong><t t-esc="state.data.kpis.avg_gpa"/> / 4.00</strong></span>
                            <i class="fa fa-chevron-right"/>
                        </div>
                    </div>

                    <!-- KPI 4: Tuition Fee Realization -->
                    <div class="uni-kpi-card" t-on-click="() => this.openFeesList()">
                        <div class="uni-kpi-top">
                            <div class="uni-kpi-info">
                                <span class="uni-kpi-label">Fee Collection Velocity</span>
                                <div class="uni-kpi-value-row">
                                    <span class="uni-kpi-value"><t t-esc="state.data.kpis.collection_rate"/>%</span>
                                    <span class="uni-kpi-pill amber">
                                        $<t t-esc="state.data.kpis.total_receivable.toLocaleString('en-US', {minimumFractionDigits: 0})"/> Due
                                    </span>
                                </div>
                            </div>
                            <div class="uni-kpi-icon amber">
                                <i class="fa fa-credit-card"/>
                            </div>
                        </div>
                        <div class="uni-kpi-footer">
                            <span>Collected: <strong>$<t t-esc="state.data.kpis.total_collected.toLocaleString('en-US', {minimumFractionDigits: 0})"/> of $<t t-esc="state.data.kpis.total_invoiced.toLocaleString('en-US', {minimumFractionDigits: 0})"/></strong></span>
                            <i class="fa fa-chevron-right"/>
                        </div>
                    </div>
                </div>

                <!-- 3. Middle Analytics Row (62% / 38%) -->
                <div class="uni-analytics-row">
                    <!-- Left: Enrollment Trends & Academic Capacity -->
                    <div class="uni-card">
                        <div>
                            <div class="uni-card-header">
                                <div>
                                    <h2>Student Enrollment Trends &amp; Capacity Forecast</h2>
                                    <p>Past semesters comparison against active institutional capacity target</p>
                                </div>
                                <div class="uni-header-badges">
                                    <span class="badge-target"><i class="fa fa-bullseye me-1"/> Target: 5,000 Seats</span>
                                    <span class="badge-term">
                                        <t t-esc="state.data.active_term_name"/>
                                    </span>
                                </div>
                            </div>

                            <!-- High-Fidelity Bar Chart -->
                            <div class="uni-trend-chart-box">
                                <div class="target-line" title="Institutional Capacity Target (5,000 Seats)"/>

                                <!-- Bar 1: Fall 22 -->
                                <div class="bar-col">
                                    <span class="bar-val">3,920</span>
                                    <div class="bar-fill-track" style="height: 95px;">
                                        <div class="bar-fill" style="height: 100%;"/>
                                    </div>
                                    <span class="bar-label">Fall '22</span>
                                </div>

                                <!-- Bar 2: Spring 23 -->
                                <div class="bar-col">
                                    <span class="bar-val">4,150</span>
                                    <div class="bar-fill-track" style="height: 105px;">
                                        <div class="bar-fill" style="height: 100%;"/>
                                    </div>
                                    <span class="bar-label">Spring '23</span>
                                </div>

                                <!-- Bar 3: Fall 23 -->
                                <div class="bar-col">
                                    <span class="bar-val">4,400</span>
                                    <div class="bar-fill-track" style="height: 115px;">
                                        <div class="bar-fill" style="height: 100%;"/>
                                    </div>
                                    <span class="bar-label">Fall '23</span>
                                </div>

                                <!-- Bar 4: Spring 24 -->
                                <div class="bar-col">
                                    <span class="bar-val">4,610</span>
                                    <div class="bar-fill-track" style="height: 125px;">
                                        <div class="bar-fill" style="height: 100%;"/>
                                    </div>
                                    <span class="bar-label">Spring '24</span>
                                </div>

                                <!-- Bar 5: Fall 24 Active -->
                                <div class="bar-col active">
                                    <span class="bar-val">4,850</span>
                                    <div class="bar-fill-track" style="height: 138px;">
                                        <div class="bar-fill" style="height: 100%;"/>
                                    </div>
                                    <span class="bar-label text-primary fw-bold">Fall '24 (Active)</span>
                                </div>
                            </div>

                            <!-- Department Capacity Tiles Subgrid -->
                            <div class="uni-dept-grid">
                                <t t-foreach="state.data.departments" t-as="dept" t-key="dept.id">
                                    <div class="dept-tile">
                                        <div class="dept-tile-header">
                                            <div class="dept-title" t-att-title="dept.name">
                                                <span class="color-bullet" t-attf-style="background-color: {{dept.color}};"/>
                                                <span class="dept-name-text"><t t-esc="dept.name"/></span>
                                            </div>
                                            <span class="dept-count">
                                                <t t-esc="dept.student_count"/> Stud • <t t-esc="dept.section_count"/> Sec
                                            </span>
                                        </div>
                                        <div class="dept-bar-track">
                                            <div class="dept-bar-fill"
                                                 t-attf-style="width: {{dept.student_count > 0 ? (dept.student_count * 35) : 5}}%; background-color: {{dept.color}};"/>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>

                    <!-- Right: Bursar Velocity & Department Attendance Pulse -->
                    <div class="uni-card">
                        <div>
                            <div class="uni-card-header">
                                <div>
                                    <h2>Institutional Health &amp; Vital Signs</h2>
                                    <p>Tuition realization velocity &amp; class attendance pulse</p>
                                </div>
                                <i class="fa fa-shield text-muted fa-lg"/>
                            </div>

                            <!-- Fee Multi-segment Bar -->
                            <div class="uni-fee-block">
                                <div class="fee-title-row">
                                    <span class="fee-label">Bursar Collections Velocity</span>
                                    <span class="fee-rate"><t t-esc="state.data.fee_velocity.collected_pct"/>% Realized</span>
                                </div>
                                <div class="fee-progress-bar" title="Collected / Pending / Overdue">
                                    <div class="seg-collected" t-attf-style="width: {{state.data.fee_velocity.collected_pct}}%;"/>
                                    <div class="seg-pending" t-attf-style="width: {{state.data.fee_velocity.pending_pct}}%;"/>
                                    <div class="seg-overdue" t-attf-style="width: {{state.data.fee_velocity.overdue_pct}}%;"/>
                                </div>

                                <div class="fee-stat-tiles">
                                    <div class="stat-tile">
                                        <span class="tile-title">Collected</span>
                                        <span class="tile-val green">
                                            $<t t-esc="state.data.fee_velocity.collected.toLocaleString('en-US', {minimumFractionDigits: 0})"/>
                                        </span>
                                    </div>
                                    <div class="stat-tile" t-on-click="() => this.openFeesList('unpaid')" role="button" title="View Pending Challans">
                                        <span class="tile-title">Pending</span>
                                        <span class="tile-val amber">
                                            $<t t-esc="state.data.fee_velocity.pending.toLocaleString('en-US', {minimumFractionDigits: 0})"/>
                                        </span>
                                    </div>
                                    <div class="stat-tile" t-on-click="() => this.openFeesList('overdue')" role="button" title="View Overdue Challans">
                                        <span class="tile-title">Overdue</span>
                                        <span class="tile-val red">
                                            $<t t-esc="state.data.fee_velocity.overdue.toLocaleString('en-US', {minimumFractionDigits: 0})"/>
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <!-- Attendance Pulse -->
                            <div class="uni-pulse-block">
                                <div class="pulse-header">
                                    <span>Department Attendance Health</span>
                                    <span>Avg <t t-esc="state.data.kpis.avg_attendance"/>%</span>
                                </div>
                                <div class="pulse-list">
                                    <t t-foreach="state.data.departments" t-as="dept" t-key="dept.id">
                                        <div t-if="dept.student_count > 0" class="pulse-item">
                                            <div class="pulse-meta">
                                                <span class="p-name"><t t-esc="dept.name"/></span>
                                                <span t-attf-class="p-rate {{dept.avg_attendance >= 75 ? 'good' : 'danger'}}">
                                                    <t t-esc="dept.avg_attendance"/>%
                                                    <t t-if="dept.avg_attendance &lt; 75"> (Alert)</t>
                                                </span>
                                            </div>
                                            <div class="pulse-track">
                                                <div t-attf-class="pulse-fill {{dept.avg_attendance >= 75 ? 'good' : 'danger'}}"
                                                     t-attf-style="width: {{dept.avg_attendance}}%;"/>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 4. Lower Grid (Recent Roster & Alerts) -->
                <div class="uni-lower-grid">
                    <!-- Left: Recent Student Registrations Table -->
                    <div class="uni-card">
                        <div class="uni-card-header">
                            <div>
                                <h2>Student Academic &amp; Financial Directory</h2>
                                <p>Active semester student profiles with real-time academic standing</p>
                            </div>
                            <span class="link-view-all" t-on-click="openStudentsList">
                                View Full Directory <i class="fa fa-arrow-right ms-1"/>
                            </span>
                        </div>

                        <div class="uni-table-container">
                            <table class="uni-table">
                                <thead>
                                    <tr>
                                        <th>Student</th>
                                        <th>Department</th>
                                        <th>Program</th>
                                        <th>CGPA</th>
                                        <th>Attendance</th>
                                        <th>Fee Standing</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.data.recent_students" t-as="student" t-key="student.id">
                                        <tr class="uni-row" t-on-click="() => this.openStudent(student.id)">
                                            <td>
                                                <div class="student-cell">
                                                    <div t-attf-class="avatar-pill {{student.student_id.includes('AI') ? 'ai' : student.student_id.includes('EE') ? 'ee' : student.student_id.includes('SE') ? 'se' : 'cs'}}">
                                                        <t t-esc="student.name.substring(0, 2).toUpperCase()"/>
                                                    </div>
                                                    <div class="student-data">
                                                        <span class="s-name"><t t-esc="student.name"/></span>
                                                        <span class="s-code"><t t-esc="student.student_id"/></span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-nowrap"><t t-esc="student.department"/></td>
                                            <td><span class="badge bg-light text-dark text-nowrap"><t t-esc="student.program"/></span></td>
                                            <td>
                                                <strong class="text-primary">
                                                    <i t-if="student.is_high_gpa" class="fa fa-trophy text-warning me-1"/>
                                                    <t t-esc="student.gpa"/>
                                                </strong>
                                            </td>
                                            <td>
                                                <span t-attf-class="fw-bold {{student.is_low_attendance ? 'text-danger' : 'text-success'}}">
                                                    <t t-esc="student.attendance_rate"/>
                                                    <i t-if="student.is_low_attendance" class="fa fa-exclamation-circle text-danger ms-1"/>
                                                </span>
                                            </td>
                                            <td>
                                                <span t-attf-class="chip {{student.fee_status}}">
                                                    <t t-esc="student.fee_status.replace('_', ' ')"/>
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                <span class="action-link">Dossier →</span>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Right: Actionable Academic & Defaulter Alerts -->
                    <div class="uni-card">
                        <div class="uni-card-header">
                            <div>
                                <h2>Urgent Compliance &amp; Defaulter Alerts</h2>
                                <p>System-generated operational notices requiring intervention</p>
                            </div>
                            <i class="fa fa-bell text-warning fa-lg"/>
                        </div>

                        <div class="uni-alerts-list">
                            <t t-foreach="state.data.alerts" t-as="alert" t-key="alert.id">
                                <div t-attf-class="uni-alert-card {{alert.type}}">
                                    <div class="alert-body">
                                        <span t-attf-class="alert-badge-tag {{alert.type}}"><t t-esc="alert.category"/></span>
                                        <h4 class="alert-h4"><t t-esc="alert.title"/></h4>
                                        <p class="alert-desc-text"><t t-esc="alert.description"/></p>
                                    </div>
                                    <button class="btn-alert-nav"
                                            t-on-click="() => this.openRecord(alert.action_model, alert.action_res_id)">
                                        <t t-esc="alert.action_label"/>
                                    </button>
                                </div>
                            </t>

                            <!-- Academic Positive Notice -->
                            <div class="uni-alert-card info">
                                <div class="alert-body">
                                    <span class="alert-badge-tag info">Dean's Honor Roll</span>
                                    <h4 class="alert-h4">Academic Distinction Recognized</h4>
                                    <p class="alert-desc-text">Ayesha Malik (NUT-2024-CS-0142) achieved a perfect 4.00 CGPA with 100% attendance in Fall 2024.</p>
                                </div>
                                <button class="btn-alert-nav" t-on-click="() => this.openStudent(1)">
                                    View Dossier
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
