<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Attendance List View -->
    <record id="view_unisphere_attendance_list" model="ir.ui.view">
        <field name="name">unisphere.attendance.list</field>
        <field name="model">unisphere.attendance</field>
        <field name="arch" type="xml">
            <list string="Class Attendance Register" sample="1">
                <field name="class_date"/>
                <field name="section_id"/>
                <field name="student_id"/>
                <field name="course_id"/>
                <field name="term_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'present'"
                       decoration-warning="state == 'late'"
                       decoration-danger="state == 'absent'"/>
                <field name="remarks"/>
            </list>
        </field>
    </record>

    <!-- Attendance Form View -->
    <record id="view_unisphere_attendance_form" model="ir.ui.view">
        <field name="name">unisphere.attendance.form</field>
        <field name="model">unisphere.attendance</field>
        <field name="arch" type="xml">
            <form string="Session Attendance Record">
                <sheet>
                    <div class="oe_title">
                        <label for="display_name" class="oe_edit_only" string="Session Record"/>
                        <h1>
                            <field name="display_name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Session &amp; Student">
                            <field name="section_id" options="{'no_create': True}"/>
                            <field name="student_id" options="{'no_create': True}"/>
                            <field name="class_date"/>
                            <field name="state" widget="radio" options="{'horizontal': true}"/>
                        </group>
                        <group string="Curricular Scope">
                            <field name="course_id"/>
                            <field name="term_id"/>
                            <field name="department_id"/>
                            <field name="enrollment_id" readonly="1"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="Observations &amp; Remarks">
                        <field name="remarks" placeholder="e.g. Excused medical certificate, Left 15 mins early..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Attendance Search View -->
    <record id="view_unisphere_attendance_search" model="ir.ui.view">
        <field name="name">unisphere.attendance.search</field>
        <field name="model">unisphere.attendance</field>
        <field name="arch" type="xml">
            <search string="Search Attendance">
                <field name="student_id"/>
                <field name="section_id"/>
                <field name="course_id"/>
                <field name="term_id"/>
                <field name="class_date"/>
                <separator/>
                <filter string="Present" name="filter_present" domain="[('state', '=', 'present')]"/>
                <filter string="Late" name="filter_late" domain="[('state', '=', 'late')]"/>
                <filter string="Absent" name="filter_absent" domain="[('state', '=', 'absent')]"/>
                <separator/>
                <filter string="Today's Sessions" name="filter_today" domain="[('class_date', '=', context_today())]"/>
                <group>
                    <filter string="Course Section" name="group_by_section" context="{'group_by': 'section_id'}"/>
                    <filter string="Class Date" name="group_by_date" context="{'group_by': 'class_date:day'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Student" name="group_by_student" context="{'group_by': 'student_id'}"/>
                    <filter string="Academic Term" name="group_by_term" context="{'group_by': 'term_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action: Attendance Records -->
    <record id="action_unisphere_attendance" model="ir.actions.act_window">
        <field name="name">Attendance Register</field>
        <field name="res_model">unisphere.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_unisphere_attendance_search"/>
        <field name="context">{'search_default_group_by_section': 1, 'search_default_group_by_date': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record student attendance!
            </p>
            <p>
                Track daily attendance per course section to ensure compliance with minimum attendance thresholds.
            </p>
        </field>
    </record>

    <!-- Attendance Wizard Form View -->
    <record id="view_unisphere_attendance_wizard_form" model="ir.ui.view">
        <field name="name">unisphere.attendance.wizard.form</field>
        <field name="model">unisphere.attendance.wizard</field>
        <field name="arch" type="xml">
            <form string="Record Class Attendance">
                <sheet>
                    <group>
                        <group string="Session Logistics">
                            <field name="section_id" readonly="context.get('default_section_id')"/>
                            <field name="class_date"/>
                        </group>
                    </group>
                    <div class="alert alert-info d-flex align-items-center mb-3" role="alert">
                        <div>
                            <strong>Faculty Roster Guide:</strong> Mark each enrolled student as <em>Present</em>, <em>Late</em>, or <em>Absent</em>. Existing entries for this date will be updated in place.
                        </div>
                    </div>
                    <notebook>
                        <page string="Student Roster">
                            <field name="line_ids">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="student_reg_no"/>
                                    <field name="student_id"/>
                                    <field name="state" widget="selection"/>
                                    <field name="remarks" placeholder="Optional notes..."/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_save_attendance" string="Save Attendance" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Window Action: Quick Attendance Wizard -->
    <record id="action_unisphere_attendance_wizard" model="ir.actions.act_window">
        <field name="name">Record Session Attendance</field>
        <field name="res_model">unisphere.attendance.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
