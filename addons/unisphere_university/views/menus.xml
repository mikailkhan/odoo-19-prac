    <menuitem id="menu_unisphere_faculty"
              name="Faculty"
              parent="menu_unisphere_people"
              action="action_unisphere_faculty"
              sequence="20"/>

    <!-- 4. Class Operations (Enrollments & Attendance) Category -->
    <menuitem id="menu_unisphere_operations"
              name="Class Operations"
              parent="menu_unisphere_root"
              sequence="40"/>

    <menuitem id="menu_unisphere_enrollments"
