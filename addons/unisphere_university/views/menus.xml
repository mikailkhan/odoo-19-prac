<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root UniSphere Navigation Menu -->
    <menuitem id="menu_unisphere_root"
              name="UniSphere"
              web_icon="unisphere_university,static/description/icon.png"
              action="action_unisphere_course_section"
              sequence="15"/>

    <!-- 1. Overview / Dashboard Category (Phase 8) -->
    <menuitem id="menu_unisphere_overview"
              name="Overview"
              parent="menu_unisphere_root"
              sequence="10"/>

    <!-- 2. Academic Operations Category -->
    <menuitem id="menu_unisphere_academics"
              name="Academics"
              parent="menu_unisphere_root"
              sequence="20"/>

    <!-- Academic Menu Sub-items -->
    <menuitem id="menu_unisphere_course_sections"
              name="Course Sections"
              parent="menu_unisphere_academics"
              action="action_unisphere_course_section"
              sequence="10"/>

    <menuitem id="menu_unisphere_courses"
              name="Courses"
              parent="menu_unisphere_academics"
              action="action_unisphere_course"
              sequence="20"/>

    <menuitem id="menu_unisphere_academic_terms"
              name="Academic Terms"
              parent="menu_unisphere_academics"
              action="action_unisphere_academic_term"
              sequence="30"/>

    <menuitem id="menu_unisphere_departments"
              name="Departments"
              parent="menu_unisphere_academics"
              action="action_unisphere_department"
              sequence="40"/>

    <!-- 3. People (Students & Faculty) Category -->
    <menuitem id="menu_unisphere_people"
              name="Students &amp; Faculty"
              parent="menu_unisphere_root"
              sequence="30"/>

    <!-- People Sub-items -->
    <menuitem id="menu_unisphere_students"
              name="Students"
              parent="menu_unisphere_people"
