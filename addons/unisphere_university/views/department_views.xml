<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Department List View -->
    <record id="view_unisphere_department_list" model="ir.ui.view">
        <field name="name">unisphere.department.list</field>
        <field name="model">unisphere.department</field>
        <field name="arch" type="xml">
            <list string="Academic Departments" sample="1">
                <field name="code"/>
                <field name="name"/>
                <field name="head_of_department_id"/>
                <field name="course_count" string="Offered Courses"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Department Form View -->
    <record id="view_unisphere_department_form" model="ir.ui.view">
        <field name="name">unisphere.department.form</field>
        <field name="model">unisphere.department</field>
        <field name="arch" type="xml">
            <form string="Academic Department">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_courses"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-book">
                            <field name="course_count" widget="statinfo" string="Courses"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="code" class="oe_edit_only" string="Department Code"/>
                        <h1>
                            <field name="code" placeholder="e.g. CS" class="oe_inline"/>
                        </h1>
                        <label for="name" class="oe_edit_only" string="Department Name"/>
                        <h2>
                            <field name="name" placeholder="e.g. Department of Computer Science"/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="head_of_department_id"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Overview &amp; Mission" name="description_page">
                            <field name="description" placeholder="Provide background, degree offerings, and research focus..."/>
                        </page>
                        <page string="Offered Courses" name="courses_page">
                            <field name="course_ids" readonly="1">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="credit_hours"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Department Search View -->
    <record id="view_unisphere_department_search" model="ir.ui.view">
        <field name="name">unisphere.department.search</field>
        <field name="model">unisphere.department</field>
        <field name="arch" type="xml">
            <search string="Search Departments">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="code"/>
                <field name="head_of_department_id"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_unisphere_department" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">unisphere.department</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_unisphere_department_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register your first academic department!
            </p>
            <p>
                Create departments (e.g. Computer Science, Electrical Engineering) to structure your courses and faculty.
            </p>
        </field>
    </record>
</odoo>
