<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ========================================== -->
    <!-- 1. BREADCRUMBS INHERITANCE                 -->
    <!-- ========================================== -->
    <template id="portal_my_home_menu_unisphere" inherit_id="portal.portal_breadcrumbs" priority="25">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'unisphere_home'" class="breadcrumb-item active">
                <span>Academic Portal</span>
            </li>
            <li t-if="page_name in ['unisphere_course_detail', 'unisphere_fees']" class="breadcrumb-item">
                <a href="/my/unisphere">Academic Portal</a>
            </li>
            <li t-if="page_name == 'unisphere_course_detail'" class="breadcrumb-item active">
                <span t-esc="section.course_id.code"/> - <span t-esc="section.section_code"/>
            </li>
            <li t-if="page_name == 'unisphere_fees'" class="breadcrumb-item active">
                <span>Tuition Fees &amp; Challans</span>
            </li>
        </xpath>
    </template>

    <!-- ========================================== -->
    <!-- 2. HOME PORTAL INJECTION (/my)             -->
    <!-- ========================================== -->
    <template id="portal_my_home_unisphere" inherit_id="portal.portal_my_home" priority="25">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/unisphere_university/static/src/img/portal-academic.svg'"/>
                <t t-set="title">UniSphere Student Portal</t>
                <t t-set="text">Academic transcript, course schedules, attendance registers, and tuition fees</t>
                <t t-set="url" t-value="'/my/unisphere'"/>
                <t t-set="placeholder_count" t-value="'unisphere_courses_count'"/>
            </t>
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/unisphere_university/static/src/img/portal-fees.svg'"/>
                <t t-set="title">Tuition &amp; Fee Challans</t>
                <t t-set="text">Fee invoices, payment status, and bank deposit instructions</t>
                <t t-set="url" t-value="'/my/unisphere/fees'"/>
                <t t-set="placeholder_count" t-value="'unisphere_fees_count'"/>
            </t>
        </xpath>
    </template>

    <!-- ========================================== -->
    <!-- 3. FALLBACK FOR USERS WITHOUT PROFILE      -->
    <!-- ========================================== -->
    <template id="portal_no_student_profile" name="No Student Profile Found">
        <t t-call="portal.portal_layout">
            <div class="container py-5 text-center">
                <div class="card shadow-sm border-0 p-5 mx-auto" style="max-width: 600px; border-radius: 12px;">
                    <i class="fa fa-graduation-cap text-primary fa-4x mb-3"/>
                    <h3 class="fw-bold text-dark">No Student Profile Linked</h3>
                    <p class="text-muted">
                        Your user account is not currently linked to an active student registration at Northstar University of Technology.
                    </p>
                    <div class="mt-3">
                        <a href="/my" class="btn btn-outline-primary px-4">Return to Portal Home</a>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ========================================== -->
    <!-- 4. MAIN STUDENT DASHBOARD (/my/unisphere)   -->
    <!-- ========================================== -->
    <template id="portal_my_dashboard" name="Student Academic Portal Dashboard">
        <t t-call="portal.portal_layout">
            <style>
                .uni-portal-hero {
                    background: linear-gradient(135deg, #000f3f 0%, #172554 100%);
                    border-radius: 12px;
                    color: #ffffff;
                    padding: 2rem 2.25rem;
                    box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.15);
                    position: relative;
                    overflow: hidden;
                    margin-bottom: 2rem;
                }
                .uni-portal-hero::after {
                    content: '';
                    position: absolute;
                    right: -20px;
                    top: -40px;
                    width: 250px;
                    height: 250px;
                    background: radial-gradient(circle, rgba(37, 99, 235, 0.25) 0%, transparent 70%);
                    border-radius: 50%;
                    pointer-events: none;
                }
                .uni-portal-stat-card {
                    background: #ffffff;
                    border: 1px solid #e2e8f0;
                    border-radius: 10px;
                    padding: 1.25rem 1.5rem;
                    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
                    transition: transform 0.2s ease, box-shadow 0.2s ease;
                    height: 100%;
                    display: flex;
                    flex-direction: column;
                    justify-content: space-between;
                }
                .uni-portal-stat-card:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 8px 16px -2px rgba(15, 23, 42, 0.08);
                }
                .uni-portal-course-card {
                    background: #ffffff;
                    border: 1px solid #e2e8f0;
                    border-radius: 10px;
                    padding: 1.25rem;
                    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
                    display: flex;
                    flex-direction: column;
                    justify-content: space-between;
                    height: 100%;
                    transition: all 0.2s ease;
                }
                .uni-portal-course-card:hover {
                    border-color: #93c5fd;
                    box-shadow: 0 8px 20px -2px rgba(37, 99, 235, 0.08);
                }
                .uni-chip {
                    display: inline-flex;
                    align-items: center;
                    gap: 0.25rem;
                    padding: 0.2rem 0.55rem;
                    border-radius: 9999px;
                    font-size: 0.75rem;
                    font-weight: 700;
                }
                .uni-chip-success { background-color: #ecfdf5; color: #047857; }
                .uni-chip-warning { background-color: #fffbeb; color: #b45309; }
                .uni-chip-danger { background-color: #fef2f2; color: #b91c1c; }
                .uni-chip-info { background-color: #eff6ff; color: #1d4ed8; }
            </style>

            <div class="uni-portal-container my-3">
                <!-- Admin Preview Notice -->
                <div t-if="is_admin_preview" class="alert alert-warning d-flex align-items-center mb-4" role="alert">
                    <i class="fa fa-info-circle fa-lg me-2"/>
                    <div>
                        <strong>Administrative Preview Mode:</strong> Viewing portal as 
                        <strong><t t-esc="student.name"/> (<t t-esc="student.student_id"/>)</strong>.
                    </div>
                </div>

                <!-- 1. Hero Identity Banner -->
                <div class="uni-portal-hero">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-white text-primary d-flex align-items-center justify-content-center fw-bold shadow-sm"
                                 style="width: 64px; height: 64px; font-size: 1.5rem; flex-shrink: 0;">
                                <t t-esc="student.name[0]"/>
                            </div>
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="badge bg-primary px-2 py-1" style="font-size: 0.75rem;">
                                        <t t-esc="student.current_term_id.name or 'Active Term'"/>
                                    </span>
                                    <span class="badge bg-success px-2 py-1 text-uppercase" style="font-size: 0.75rem;">
                                        <t t-esc="student.state"/>
                                    </span>
                                </div>
                                <h2 class="fw-bold mb-0 text-white"><t t-esc="student.name"/></h2>
                                <p class="text-white-50 mb-0 small">
                                    Roll #: <strong><t t-esc="student.student_id"/></strong> • 
                                    <t t-esc="student.department_id.name"/>
                                </p>
                            </div>
                        </div>
                        <div class="text-md-end">
                            <span class="text-white-50 small d-block">Academic Program</span>
                            <span class="fw-bold fs-6 text-white"><t t-esc="dict(student._fields['program'].selection).get(student.program)"/></span>
                        </div>
                    </div>
                </div>

                <!-- 2. Academic & Financial KPI Cards -->
                <div class="row g-3 mb-4">
                    <!-- CGPA Card -->
                    <div class="col-md-4">
                        <div class="uni-portal-stat-card">
                            <div>
                                <span class="text-muted text-uppercase fw-bold" style="font-size: 0.75rem; letter-spacing: 0.05em;">Cumulative CGPA</span>
                                <div class="d-flex align-items-baseline gap-2 mt-2">
                                    <h2 class="fw-bold text-dark mb-0"><t t-esc="f'{student.gpa:.2f}'"/></h2>
                                    <span class="text-muted small">/ 4.00</span>
                                    <span t-if="student.gpa >= 3.50" class="uni-chip uni-chip-success ms-auto">
                                        <i class="fa fa-trophy text-warning me-1"/> Dean's Honor
                                    </span>
                                </div>
                            </div>
                            <div class="mt-3 pt-2 border-top text-muted small">
                                Institutional Standard: 2.00 Minimum
                            </div>
                        </div>
                    </div>

                    <!-- Attendance Card -->
                    <div class="col-md-4">
                        <div class="uni-portal-stat-card">
                            <div>
                                <span class="text-muted text-uppercase fw-bold" style="font-size: 0.75rem; letter-spacing: 0.05em;">Attendance Health</span>
                                <div class="d-flex align-items-baseline gap-2 mt-2">
                                    <h2 class="fw-bold mb-0" t-att-class="'text-danger' if student.attendance_rate &lt; 75 else 'text-dark'">
                                        <t t-esc="f'{student.attendance_rate:.1f}'"/>%
                                    </h2>
                                    <span t-if="student.attendance_rate >= 75" class="uni-chip uni-chip-success ms-auto">
                                        <i class="fa fa-check-circle me-1"/> Standard Met
                                    </span>
                                    <span t-else="" class="uni-chip uni-chip-danger ms-auto">
                                        <i class="fa fa-exclamation-triangle me-1"/> Below 75%
                                    </span>
                                </div>
                            </div>
                            <div class="mt-3 pt-2 border-top text-muted small">
                                Attended <t t-esc="attendance_present_count"/> of <t t-esc="attendance_total_count"/> sessions held
                            </div>
                        </div>
                    </div>

                    <!-- Fee Status Card -->
                    <div class="col-md-4">
                        <div class="uni-portal-stat-card">
                            <div>
                                <span class="text-muted text-uppercase fw-bold" style="font-size: 0.75rem; letter-spacing: 0.05em;">Bursar Account Standing</span>
                                <div class="d-flex align-items-baseline gap-2 mt-2">
                                    <h2 class="fw-bold mb-0" t-att-class="'text-danger' if total_balance_due > 0 else 'text-success'">
                                        $<t t-esc="f'{total_balance_due:,.2f}'"/>
                                    </h2>
                                    <span t-if="total_balance_due == 0" class="uni-chip uni-chip-success ms-auto">
                                        <i class="fa fa-check me-1"/> Clear
                                    </span>
                                    <span t-else="" class="uni-chip uni-chip-warning ms-auto">
                                        <i class="fa fa-clock-o me-1"/> Dues Pending
                                    </span>
                                </div>
                            </div>
                            <div class="mt-3 pt-2 border-top d-flex justify-content-between align-items-center">
                                <span class="text-muted small">Paid: $<t t-esc="f'{total_paid:,.0f}'"/> of $<t t-esc="f'{total_invoiced:,.0f}'"/></span>
                                <a href="/my/unisphere/fees" class="small fw-bold text-decoration-none text-primary">View Fees →</a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. Active Enrolled Courses -->
                <div class="card shadow-sm border-0 mb-4" style="border-radius: 10px;">
                    <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                        <div>
                            <h5 class="fw-bold mb-0 text-dark">Active Course Registrations</h5>
                            <small class="text-muted">Enrolled courses for current semester</small>
                        </div>
                        <span class="badge bg-light text-dark border">
                            <t t-esc="len(active_enrollments)"/> Course(s)
                        </span>
                    </div>
                    <div class="card-body p-3">
                        <div class="row g-3">
                            <t t-foreach="active_enrollments" t-as="enrollment">
                                <div class="col-md-6">
                                    <div class="uni-portal-course-card">
                                        <div>
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <span class="badge bg-primary px-2 py-1">
                                                    <t t-esc="enrollment.section_id.course_id.code"/> - <t t-esc="enrollment.section_id.section_code"/>
                                                </span>
                                                <span class="text-muted small fw-bold">
                                                    <t t-esc="enrollment.section_id.course_id.credit_hours"/> Credit Hours
                                                </span>
                                            </div>
                                            <h6 class="fw-bold text-dark mb-2">
                                                <t t-esc="enrollment.section_id.course_id.name"/>
                                            </h6>
                                            <div class="text-muted small mb-3">
                                                <div><i class="fa fa-user me-1 text-primary"/> <t t-esc="enrollment.section_id.instructor_id.name"/></div>
                                                <div><i class="fa fa-calendar me-1 text-primary"/> <t t-esc="enrollment.section_id.schedule"/></div>
                                                <div><i class="fa fa-map-marker me-1 text-primary"/> <t t-esc="enrollment.section_id.classroom"/></div>
                                            </div>
                                        </div>
                                        <div class="border-top pt-2 d-flex justify-content-between align-items-center">
                                            <span class="small text-muted">
                                                Attendance: <strong t-esc="f'{enrollment.attendance_rate:.0f}%'"/>
                                            </span>
                                            <a t-attf-href="/my/unisphere/courses/{{enrollment.section_id.id}}"
                                               class="btn btn-sm btn-outline-primary fw-bold">
                                                View Course &amp; Grades →
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>

                <!-- 4. Recent Published Assessments & Grades -->
                <div class="card shadow-sm border-0" style="border-radius: 10px;">
                    <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                        <div>
                            <h5 class="fw-bold mb-0 text-dark">Recent Academic Assessments &amp; Grades</h5>
                            <small class="text-muted">Published quiz, midterm, and assignment results</small>
                        </div>
                        <i class="fa fa-line-chart text-muted"/>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr class="text-uppercase small text-muted">
                                    <th>Assessment</th>
                                    <th>Course</th>
                                    <th>Type</th>
                                    <th>Weight</th>
                                    <th>Marks</th>
                                    <th>Grade</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="not recent_grades">
                                    <tr>
                                        <td colspan="7" class="text-center py-4 text-muted">
                                            No published assessment grades available yet.
                                        </td>
                                    </tr>
                                </t>
                                <t t-foreach="recent_grades" t-as="grade">
                                    <tr>
                                        <td>
                                            <strong class="text-dark"><t t-esc="grade.assessment_id.name"/></strong>
                                            <small class="d-block text-muted"><t t-esc="grade.assessment_id.due_date"/></small>
                                        </td>
                                        <td>
                                            <span t-esc="grade.assessment_id.section_id.course_id.code"/>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark text-capitalize">
                                                <t t-esc="grade.assessment_id.assessment_type"/>
                                            </span>
                                        </td>
                                        <td><t t-esc="grade.assessment_id.weightage"/>%</td>
                                        <td>
                                            <strong><t t-esc="grade.marks_obtained"/></strong> / <t t-esc="grade.assessment_id.max_marks"/>
                                            <small class="text-muted">(<t t-esc="f'{grade.percentage:.1f}'"/>%)</small>
                                        </td>
                                        <td>
                                            <span class="badge bg-primary">
                                                <t t-esc="grade.letter_grade or '—'"/>
                                            </span>
                                        </td>
                                        <td>
                                            <span class="uni-chip uni-chip-success">Published</span>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ============================================================= -->
    <!-- 5. COURSE SECTION DETAIL (/my/unisphere/courses/<id>)          -->
    <!-- ============================================================= -->
    <template id="portal_course_section_detail" name="Student Course Section Details">
        <t t-call="portal.portal_layout">
            <div class="uni-portal-container my-3">
                <!-- Course Hero Banner -->
                <div class="card shadow-sm border-0 mb-4 p-4" style="background: linear-gradient(135deg, #000f3f 0%, #172554 100%); border-radius: 12px; color: #ffffff;">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="badge bg-primary px-2 py-1"><t t-esc="section.course_id.code"/></span>
                                <span class="badge bg-light text-dark px-2 py-1"><t t-esc="section.section_code"/></span>
                                <span class="badge bg-info px-2 py-1"><t t-esc="section.term_id.name"/></span>
                            </div>
                            <h2 class="fw-bold mb-1 text-white"><t t-esc="section.course_id.name"/></h2>
                            <p class="text-white-50 mb-0">
                                Instructor: <strong><t t-esc="section.instructor_id.name"/></strong> • 
                                <t t-esc="section.classroom"/> • <t t-esc="section.schedule"/>
                            </p>
                        </div>
                        <div class="text-md-end bg-white bg-opacity-10 p-3 rounded">
                            <span class="text-white-50 small d-block">Section Attendance</span>
                            <span class="fw-bold fs-4 text-white"><t t-esc="attendance_percentage"/>%</span>
                            <small class="d-block text-white-50">(<t t-esc="present_sessions"/> of <t t-esc="total_sessions"/> sessions)</small>
                        </div>
                    </div>
                </div>

                <!-- Assessments & Attendance Tabs / Cards -->
                <div class="row g-4">
                    <!-- Left: Continuous Assessment Gradebook -->
                    <div class="col-lg-7">
                        <div class="card shadow-sm border-0 h-100" style="border-radius: 10px;">
                            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                                <div>
                                    <h5 class="fw-bold mb-0 text-dark">Course Assessments &amp; Results</h5>
                                    <small class="text-muted">Published grades for this course section</small>
                                </div>
                                <i class="fa fa-graduation-cap text-primary"/>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light small text-uppercase text-muted">
                                        <tr>
                                            <th>Assessment</th>
                                            <th>Date</th>
                                            <th>Weight</th>
                                            <th>Marks</th>
                                            <th>Grade</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-if="not grades">
                                            <tr>
                                                <td colspan="5" class="text-center py-4 text-muted">
                                                    No published assessments yet for this course.
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-foreach="grades" t-as="g">
                                            <tr>
                                                <td>
                                                    <strong class="text-dark"><t t-esc="g.assessment_id.name"/></strong>
                                                    <small class="d-block text-muted text-capitalize"><t t-esc="g.assessment_id.assessment_type"/></small>
                                                </td>
                                                <td><small class="text-muted"><t t-esc="g.assessment_id.due_date"/></small></td>
                                                <td><t t-esc="g.assessment_id.weightage"/>%</td>
                                                <td>
                                                    <strong><t t-esc="g.marks_obtained"/></strong> / <t t-esc="g.assessment_id.max_marks"/>
                                                    <small class="text-muted d-block">(<t t-esc="f'{g.percentage:.1f}'"/>%)</small>
                                                </td>
                                                <td>
                                                    <span class="badge bg-primary"><t t-esc="g.letter_grade or '—'"/></span>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Right: Session Attendance Register -->
                    <div class="col-lg-5">
                        <div class="card shadow-sm border-0 h-100" style="border-radius: 10px;">
                            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                                <div>
                                    <h5 class="fw-bold mb-0 text-dark">Attendance Register</h5>
                                    <small class="text-muted">Class-by-class attendance record</small>
                                </div>
                                <i class="fa fa-calendar-check-o text-success"/>
                            </div>
                            <div class="table-responsive" style="max-height: 480px; overflow-y: auto;">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light small text-uppercase text-muted">
                                        <tr>
                                            <th>Session Date</th>
                                            <th>Status</th>
                                            <th>Notes</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-if="not attendances">
                                            <tr>
                                                <td colspan="3" class="text-center py-4 text-muted">
                                                    No attendance sessions recorded yet.
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-foreach="attendances" t-as="att">
                                            <tr>
                                                <td>
                                                    <strong class="text-dark"><t t-esc="att.class_date"/></strong>
                                                </td>
                                                <td>
                                                    <span t-if="att.state == 'present'" class="badge bg-success">Present</span>
                                                    <span t-elif="att.state == 'late'" class="badge bg-warning text-dark">Late</span>
                                                    <span t-elif="att.state == 'absent'" class="badge bg-danger">Absent</span>
                                                    <span t-else="" class="badge bg-secondary">Excused</span>
                                                </td>
                                                <td>
                                                    <small class="text-muted"><t t-esc="att.remarks or '—'"/></small>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-4">
                    <a href="/my/unisphere" class="btn btn-outline-secondary">
                        <i class="fa fa-arrow-left me-1"/> Back to Academic Portal
                    </a>
                </div>
            </div>
        </t>
    </template>

    <!-- ============================================================= -->
    <!-- 6. STUDENT FEE LEDGER (/my/unisphere/fees)                    -->
    <!-- ============================================================= -->
    <template id="portal_my_fees" name="Student Fee Ledger &amp; Challans">
        <t t-call="portal.portal_layout">
            <div class="uni-portal-container my-3">
                <!-- Header Banner -->
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                    <div>
                        <h2 class="fw-bold text-dark mb-1">Tuition &amp; Fee Challans</h2>
                        <p class="text-muted mb-0">Official institutional billing ledger for <t t-esc="student.name"/> (<t t-esc="student.student_id"/>)</p>
                    </div>
                    <a href="/my/unisphere" class="btn btn-outline-primary btn-sm">
                        <i class="fa fa-dashboard me-1"/> Academic Dashboard
                    </a>
                </div>

                <!-- Financial Stats Row -->
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="card shadow-sm border-0 p-3" style="border-radius: 10px; border-left: 4px solid #0f766e !important;">
                            <span class="text-muted text-uppercase small fw-bold">Total Invoiced</span>
                            <h3 class="fw-bold text-dark mt-2 mb-0">$<t t-esc="f'{total_invoiced:,.2f}'"/></h3>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card shadow-sm border-0 p-3" style="border-radius: 10px; border-left: 4px solid #10b981 !important;">
                            <span class="text-muted text-uppercase small fw-bold">Total Paid</span>
                            <h3 class="fw-bold text-success mt-2 mb-0">$<t t-esc="f'{total_paid:,.2f}'"/></h3>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card shadow-sm border-0 p-3" style="border-radius: 10px; border-left: 4px solid #ef4444 !important;">
                            <span class="text-muted text-uppercase small fw-bold">Outstanding Balance</span>
                            <h3 class="fw-bold text-danger mt-2 mb-0">$<t t-esc="f'{total_balance_due:,.2f}'"/></h3>
                        </div>
                    </div>
                </div>

                <!-- Payment Instructions Notice if Dues are Pending -->
                <div t-if="total_balance_due > 0" class="alert alert-warning border-warning shadow-sm mb-4" role="alert" style="border-radius: 10px;">
                    <div class="d-flex gap-3 align-items-start">
                        <i class="fa fa-university fa-2x text-warning mt-1"/>
                        <div>
                            <h6 class="fw-bold text-dark mb-1">Bank Deposit &amp; Challan Payment Instructions</h6>
                            <p class="small text-muted mb-2">
                                Please print your active fee challan and deposit the due amount at any authorized branch of 
                                <strong>Allied Bank Limited</strong> or <strong>Habib Bank Limited (HBL)</strong> nationwide.
                            </p>
                            <div class="small fw-bold text-dark">
                                • Account Title: Northstar University of Technology (Tuition Collection)<br/>
                                • IBAN: PK36ABPA0010023456780019<br/>
                                • Reference: Your Challan Number (e.g. <t t-esc="fees[0].challan_number if fees else 'NUT-2024-FEE-XXXX'"/>)
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Fee Challans Ledger Table -->
                <div class="card shadow-sm border-0 mb-4" style="border-radius: 10px;">
                    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0 text-dark">Fee Challan Statements</h5>
                        <i class="fa fa-file-text-o text-muted"/>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small text-uppercase text-muted">
                                <tr>
                                    <th>Challan #</th>
                                    <th>Term</th>
                                    <th>Fee Type</th>
                                    <th>Due Date</th>
                                    <th>Invoiced</th>
                                    <th>Paid</th>
                                    <th>Balance</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="not fees">
                                    <tr>
                                        <td colspan="8" class="text-center py-4 text-muted">
                                            No fee challan records found for your account.
                                        </td>
                                    </tr>
                                </t>
                                <t t-foreach="fees" t-as="fee">
                                    <tr>
                                        <td>
                                            <strong class="text-primary font-monospace"><t t-esc="fee.challan_number"/></strong>
                                            <small class="d-block text-muted">Issued: <t t-esc="fee.issue_date"/></small>
                                        </td>
                                        <td><t t-esc="fee.term_id.name"/></td>
                                        <td>
                                            <span class="badge bg-light text-dark text-capitalize">
                                                <t t-esc="dict(fee._fields['fee_type'].selection).get(fee.fee_type)"/>
                                            </span>
                                        </td>
                                        <td>
                                            <span t-att-class="'text-danger fw-bold' if fee.state == 'overdue' else 'text-dark'">
                                                <t t-esc="fee.due_date"/>
                                            </span>
                                        </td>
                                        <td><strong>$<t t-esc="f'{fee.amount_due:,.2f}'"/></strong></td>
                                        <td><span class="text-success">$<t t-esc="f'{fee.amount_paid:,.2f}'"/></span></td>
                                        <td>
                                            <strong t-att-class="'text-danger' if fee.balance_due > 0 else 'text-muted'">
                                                $<t t-esc="f'{fee.balance_due:,.2f}'"/>
                                            </strong>
                                        </td>
                                        <td>
                                            <span t-if="fee.state == 'paid'" class="badge bg-success">PAID</span>
                                            <span t-elif="fee.state in ['posted', 'partial']" class="badge bg-warning text-dark">PENDING</span>
                                            <span t-elif="fee.state == 'overdue'" class="badge bg-danger">OVERDUE</span>
                                            <span t-else="" class="badge bg-secondary">DRAFT</span>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
