<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Course Section List View -->
    <record id="view_unisphere_course_section_list" model="ir.ui.view">
        <field name="name">unisphere.course.section.list</field>
        <field name="model">unisphere.course.section</field>
        <field name="arch" type="xml">
            <list string="Course Sections" sample="1">
                <field name="name"/>
                <field name="course_id"/>
                <field name="term_id"/>
                <field name="department_id"/>
                <field name="instructor_id"/>
                <field name="classroom"/>
                <field name="schedule"/>
                <field name="capacity"/>
                <field name="enrolled_count"/>
                <field name="seats_available"/>
                <field name="total_sessions_held" string="Sessions"/>
                <field name="average_attendance_rate" widget="progressbar" string="Avg Attendance"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'open'"
                       decoration-warning="state == 'closed'"
                       decoration-info="state == 'draft'"
                       decoration-muted="state == 'completed'"/>
            </list>
        </field>
    </record>

    <!-- Course Section Form View -->
    <record id="view_unisphere_course_section_form" model="ir.ui.view">
        <field name="name">unisphere.course.section.form</field>
        <field name="model">unisphere.course.section</field>
        <field name="arch" type="xml">
            <form string="Course Section Offering">
                <header>
                    <button name="action_take_attendance" string="Take Attendance" type="object"
                            class="btn btn-primary" icon="fa-calendar-check-o" invisible="state == 'draft'"/>
                    <button name="action_open_registration" string="Open Registration" type="object"
                            class="oe_highlight" invisible="state == 'open'"/>
                    <button name="action_close_registration" string="Close Registration" type="object"
                            invisible="state in ('closed', 'completed')"/>
                    <button name="action_mark_completed" string="Mark Completed" type="object"
                            invisible="state == 'completed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,closed,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_roster"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-users">
                            <field name="enrolled_count" widget="statinfo" string="Roster"/>
                        </button>
                        <button name="action_view_attendance"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-calendar-check-o">
                            <field name="attendance_count" widget="statinfo" string="Attendance"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Section Identifier"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Curricular Scope">
                            <field name="course_id"/>
                            <field name="term_id"/>
                            <field name="section_code" placeholder="e.g. CS-1A"/>
                            <field name="department_id"/>
                        </group>
                        <group string="Logistics &amp; Faculty">
                            <field name="instructor_id"/>
                            <field name="classroom" placeholder="e.g. Hall B-104"/>
                            <field name="schedule" placeholder="e.g. Mon / Wed 09:00 - 10:30"/>
                        </group>
                    </group>
                    <group string="Class Capacity &amp; Attendance Metrics">
                        <group>
                            <field name="capacity"/>
                            <field name="enrolled_count"/>
                            <field name="seats_available"/>
                        </group>
                        <group>
                            <field name="total_sessions_held"/>
                            <field name="average_attendance_rate" widget="progressbar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Student Roster" name="roster_page">
                            <field name="enrollment_ids" readonly="1">
                                <list>
                                    <field name="student_id"/>
                                    <field name="enrollment_date"/>
                                    <field name="attendance_rate" widget="badge"
                                           decoration-success="attendance_rate >= 75"
                                           decoration-danger="attendance_rate &lt; 75"/>
                                    <field name="final_grade"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'enrolled'"
                                           decoration-warning="state == 'dropped'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Attendance Log" name="attendance_page">
                            <field name="attendance_ids" readonly="1">
                                <list>
                                    <field name="class_date"/>
                                    <field name="student_id"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'present'"
                                           decoration-warning="state == 'late'"
                                           decoration-danger="state == 'absent'"/>
                                    <field name="remarks"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Course Section Search View -->
    <record id="view_unisphere_course_section_search" model="ir.ui.view">
        <field name="name">unisphere.course.section.search</field>
        <field name="model">unisphere.course.section</field>
        <field name="arch" type="xml">
            <search string="Search Course Sections">
                <field name="name" filter_domain="['|', '|', ('name', 'ilike', self), ('section_code', 'ilike', self), ('course_id', 'ilike', self)]"/>
                <field name="course_id"/>
                <field name="term_id"/>
                <field name="instructor_id"/>
                <field name="department_id"/>
                <separator/>
                <filter string="Open for Registration" name="filter_open" domain="[('state', '=', 'open')]"/>
                <filter string="Registration Closed" name="filter_closed" domain="[('state', '=', 'closed')]"/>
                <filter string="Completed" name="filter_completed" domain="[('state', '=', 'completed')]"/>
                <group>
                    <filter string="Academic Term" name="group_by_term" context="{'group_by': 'term_id'}"/>
                    <filter string="Course" name="group_by_course" context="{'group_by': 'course_id'}"/>
                    <filter string="Department" name="group_by_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Instructor" name="group_by_instructor" context="{'group_by': 'instructor_id'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_unisphere_course_section" model="ir.actions.act_window">
        <field name="name">Course Sections</field>
        <field name="res_model">unisphere.course.section</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_unisphere_course_section_search"/>
        <field name="context">{'search_default_group_by_term': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a course section offering!
            </p>
            <p>
                Link a course to a specific academic semester, assign an instructor, schedule, and room, and set capacity.
            </p>
        </field>
    </record>
</odoo>
