<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Enrollment List View -->
    <record id="view_unisphere_enrollment_list" model="ir.ui.view">
        <field name="name">unisphere.enrollment.list</field>
        <field name="model">unisphere.enrollment</field>
        <field name="arch" type="xml">
            <list string="Course Enrollments" sample="1">
                <field name="student_id"/>
                <field name="section_id"/>
                <field name="course_id"/>
                <field name="term_id"/>
                <field name="department_id"/>
                <field name="enrollment_date"/>
                <field name="final_grade"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'enrolled'"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'dropped'"
                       decoration-muted="state == 'completed'"/>
            </list>
        </field>
    </record>

    <!-- Enrollment Form View -->
    <record id="view_unisphere_enrollment_form" model="ir.ui.view">
        <field name="name">unisphere.enrollment.form</field>
        <field name="model">unisphere.enrollment</field>
        <field name="arch" type="xml">
            <form string="Course Enrollment Record">
                <header>
                    <button name="action_confirm_enrollment" string="Confirm Registration" type="object"
                            class="oe_highlight" invisible="state == 'enrolled'"/>
                    <button name="action_drop_enrollment" string="Drop / Withdraw" type="object"
                            invisible="state in ('dropped', 'completed')"/>
                    <button name="action_complete_enrollment" string="Mark Completed" type="object"
                            invisible="state != 'enrolled'"/>
                    <button name="action_reset_draft" string="Reset to Pending" type="object"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,enrolled,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="display_name" class="oe_edit_only" string="Enrollment Summary"/>
                        <h1>
                            <field name="display_name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Registration Scope">
                            <field name="student_id" options="{'no_create': True}"/>
                            <field name="section_id" options="{'no_create': True}"/>
                            <field name="enrollment_date"/>
                        </group>
                        <group string="Curricular Context">
                            <field name="course_id"/>
                            <field name="term_id"/>
                            <field name="department_id"/>
                            <field name="final_grade"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Enrollment Pivot View -->
    <record id="view_unisphere_enrollment_pivot" model="ir.ui.view">
        <field name="name">unisphere.enrollment.pivot</field>
        <field name="model">unisphere.enrollment</field>
        <field name="arch" type="xml">
            <pivot string="Enrollment Analytics" sample="1">
                <field name="term_id" type="row"/>
                <field name="department_id" type="row"/>
                <field name="state" type="col"/>
            </pivot>
        </field>
    </record>

    <!-- Enrollment Search View -->
    <record id="view_unisphere_enrollment_search" model="ir.ui.view">
        <field name="name">unisphere.enrollment.search</field>
        <field name="model">unisphere.enrollment</field>
        <field name="arch" type="xml">
            <search string="Search Enrollments">
                <field name="student_id"/>
                <field name="section_id"/>
                <field name="course_id"/>
                <field name="term_id"/>
                <field name="department_id"/>
                <separator/>
                <filter string="Confirmed Enrollments" name="filter_enrolled" domain="[('state', '=', 'enrolled')]"/>
                <filter string="Pending Approval" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Dropped / Withdrawn" name="filter_dropped" domain="[('state', '=', 'dropped')]"/>
                <filter string="Completed" name="filter_completed" domain="[('state', '=', 'completed')]"/>
                <group>
                    <filter string="Course Section" name="group_by_section" context="{'group_by': 'section_id'}"/>
                    <filter string="Student" name="group_by_student" context="{'group_by': 'student_id'}"/>
                    <filter string="Academic Term" name="group_by_term" context="{'group_by': 'term_id'}"/>
                    <filter string="Department" name="group_by_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_unisphere_enrollment" model="ir.actions.act_window">
        <field name="name">Course Enrollments</field>
        <field name="res_model">unisphere.enrollment</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="search_view_id" ref="view_unisphere_enrollment_search"/>
        <field name="context">{'search_default_filter_enrolled': 1, 'search_default_group_by_section': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Enroll a student into a course section!
            </p>
            <p>
                Validate section capacities and enroll students into active courses.
            </p>
        </field>
    </record>
</odoo>
