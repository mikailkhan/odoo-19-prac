<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Academic Term List View -->
    <record id="view_unisphere_academic_term_list" model="ir.ui.view">
        <field name="name">unisphere.academic.term.list</field>
        <field name="model">unisphere.academic.term</field>
        <field name="arch" type="xml">
            <list string="Academic Semesters" sample="1">
                <field name="code"/>
                <field name="name"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="section_count" string="Sections"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-info="state == 'draft'"
                       decoration-muted="state == 'closed'"/>
            </list>
        </field>
    </record>

    <!-- Academic Term Form View -->
    <record id="view_unisphere_academic_term_form" model="ir.ui.view">
        <field name="name">unisphere.academic.term.form</field>
        <field name="model">unisphere.academic.term</field>
        <field name="arch" type="xml">
            <form string="Academic Semester">
                <header>
                    <button name="action_set_active" string="Activate Semester" type="object"
                            class="oe_highlight" invisible="state == 'active'"/>
                    <button name="action_set_closed" string="Conclude Semester" type="object"
                            invisible="state == 'closed'"/>
                    <button name="action_set_draft" string="Reset to Draft" type="object"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sections"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-th-list">
                            <field name="section_count" widget="statinfo" string="Sections"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="code" class="oe_edit_only" string="Term Code"/>
                        <h1>
                            <field name="code" placeholder="e.g. F24" class="oe_inline"/>
                        </h1>
                        <label for="name" class="oe_edit_only" string="Term Name"/>
                        <h2>
                            <field name="name" placeholder="e.g. Fall 2024"/>
                        </h2>
                    </div>
                    <group>
                        <group string="Semester Duration">
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                        <group string="Course Registration Window">
                            <field name="registration_start"/>
                            <field name="registration_end"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Scheduled Course Sections" name="sections_page">
                            <field name="section_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="course_id"/>
                                    <field name="instructor_id"/>
                                    <field name="classroom"/>
                                    <field name="capacity"/>
                                    <field name="enrolled_count"/>
                                    <field name="seats_available"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Academic Term Search View -->
    <record id="view_unisphere_academic_term_search" model="ir.ui.view">
        <field name="name">unisphere.academic.term.search</field>
        <field name="model">unisphere.academic.term</field>
        <field name="arch" type="xml">
            <search string="Search Semesters">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="code"/>
                <separator/>
                <filter string="Active Semester" name="active_term" domain="[('state', '=', 'active')]"/>
                <filter string="Upcoming / Draft" name="draft_term" domain="[('state', '=', 'draft')]"/>
                <filter string="Concluded" name="closed_term" domain="[('state', '=', 'closed')]"/>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_unisphere_academic_term" model="ir.actions.act_window">
        <field name="name">Academic Terms</field>
        <field name="res_model">unisphere.academic.term</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_unisphere_academic_term_search"/>
        <field name="context">{'search_default_active_term': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define an academic semester!
            </p>
            <p>
                Configure terms like Fall 2024 or Spring 2025 to manage offerings, enrollments, and academic calendars.
            </p>
        </field>
    </record>
</odoo>
