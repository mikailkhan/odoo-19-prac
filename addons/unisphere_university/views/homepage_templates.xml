    <!-- 2. LOGIN PAGE ENHANCEMENT (BRANDING & 1-CLICK DEMO BUTTONS)  -->
    <!-- ============================================================= -->
    <template id="unisphere_login_enhancement" inherit_id="web.login" priority="20">
        <!-- University Brand Banner above login -->
        <xpath expr="//div[@id='oe_structure_login_top']" position="inside">
            <div class="text-center mb-3">
                <h5 class="fw-bold text-dark mb-0">Northstar University of Technology</h5>
                <small class="text-muted">Institutional Single Sign-On • UniSphere ERP</small>
            </div>

            <!-- Quick Demo Credentials Box -->
            <div class="card border bg-light shadow-sm mb-3 text-start" style="border-radius: 10px;">
                <div class="card-body p-2">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <small class="fw-bold text-dark"><i class="fa fa-bolt text-warning me-1"/> Quick Demo Sign-In:</small>
                        <span class="badge bg-primary" style="font-size: 0.65rem;">1-Click</span>
                    </div>
                    <div class="d-grid gap-1">
                        <button type="button" class="btn btn-outline-primary btn-sm text-start py-1 px-2 d-flex justify-content-between align-items-center" onclick="autofillLogin('student.ayesha@northstar.edu', 'student123', '/my/unisphere')">
                            <span><i class="fa fa-graduation-cap me-1"/> <strong>Ayesha</strong> (Student • 4.00)</span>
                            <small class="text-muted">Fill →</small>
                        </button>
                        <button type="button" class="btn btn-outline-warning btn-sm text-start py-1 px-2 d-flex justify-content-between align-items-center text-dark" onclick="autofillLogin('student.usman@northstar.edu', 'student123', '/my/unisphere')">
                            <span><i class="fa fa-exclamation-triangle me-1 text-danger"/> <strong>Usman</strong> (Student • Alert)</span>
                            <small class="text-muted">Fill →</small>
                        </button>
                        <button type="button" class="btn btn-outline-dark btn-sm text-start py-1 px-2 d-flex justify-content-between align-items-center" onclick="autofillLogin('khanmikail1002@gmail.com', 'admin123', '/odoo')">
                            <span><i class="fa fa-shield me-1 text-primary"/> <strong>Admin</strong> (Registrar / ERP)</span>
                            <small class="text-muted">Fill →</small>
                        </button>
                    </div>
                </div>
            </div>

            <script type="text/javascript">
                function autofillLogin(login, password, redirect) {
                    var loginInput = document.querySelector('input[name="login"]');
                    var passInput = document.querySelector('input[name="password"]');
                    var redirInput = document.querySelector('input[name="redirect"]');
                    var form = document.querySelector('form.oe_login_form');
                    
                    if (loginInput) loginInput.value = login;
                    if (passInput) passInput.value = password;
                    if (redirInput &amp;&amp; redirect) redirInput.value = redirect;
                    
                    // Unhide form if Odoo user_switch component hid it
                    if (form) {
                        form.classList.remove('d-none');
                        form.submit();
                    }
                }
            </script>
        </xpath>

        <!-- Homepage link below login buttons -->
        <xpath expr="//div[@id='oe_structure_login_bottom']" position="inside">
            <div class="text-center mt-3">
                <a href="/" class="text-decoration-none small text-muted">
                    <i class="fa fa-arrow-left me-1"/> Return to University Homepage
                </a>
            </div>
        </xpath>
    </template>
</odoo>
